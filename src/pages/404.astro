---
/**
 * 404 Page
 *
 * Brand-styled not-found page. Prerendered so Astro emits dist/404.html, which
 * Netlify serves automatically for unmatched routes. Static and lightweight —
 * no scroll canvas — and kept out of the index.
 */

import BaseLayout from '../layouts/BaseLayout.astro';

// Emit static HTML (dist/404.html) rather than an SSR route.
export const prerender = true;
---

<BaseLayout title="Page not found" noIndex={true}>
  <main class="notfound">
    <!-- Geometric motif: the same smoothed triangle used across the site -->
    <svg class="notfound-mark" viewBox="-105.49 -117 210.98 202.75" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path
        d="M -86.603 50 C -101.036 25 -28.868 -100 0 -100 C 28.868 -100 101.036 25 86.603 50 C 72.169 75 -72.169 75 -86.603 50 Z"
        stroke="#DC143C"
        stroke-width="14"
        fill="none"
      />
    </svg>

    <p class="notfound-code">404</p>
    <h1 class="notfound-title">Page not found</h1>
    <p class="notfound-text">
      The page you're looking for doesn't exist or has moved.
    </p>

    <div class="notfound-actions">
      <a class="notfound-btn primary" href="/">Back to home</a>
      <a class="notfound-btn" href="/farshid-pourlatifi.pdf" download>Download CV</a>
    </div>
  </main>
</BaseLayout>

<style>
  .notfound {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-8);
    background: var(--color-primary);
  }

  .notfound-mark {
    width: 96px;
    height: auto;
    margin-bottom: var(--space-8);
  }

  .notfound-code {
    font-family: var(--font-display);
    font-weight: var(--font-bold);
    font-size: clamp(3rem, 10vw, 5rem);
    line-height: 1;
    color: var(--color-secondary-light);
    margin: 0;
  }

  .notfound-title {
    font-family: var(--font-display);
    font-weight: var(--font-semibold);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    color: var(--color-white);
    margin: var(--space-3) 0 0 0;
  }

  .notfound-text {
    font-family: var(--font-display);
    font-weight: var(--font-normal);
    font-size: var(--text-base);
    color: var(--color-blue-light);
    margin: var(--space-4) 0 var(--space-8) 0;
    max-width: 420px;
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
  }

  .notfound-btn {
    font-family: var(--font-display);
    font-weight: var(--font-semibold);
    font-size: var(--text-base);
    color: var(--color-white);
    padding: var(--space-4) var(--space-6);
    border: 2px solid var(--color-secondary-light);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition:
      background var(--transition-base),
      color var(--transition-base),
      transform var(--transition-base);
  }

  .notfound-btn:hover {
    background: var(--color-secondary-light);
    color: var(--color-primary);
    transform: translateY(-2px);
  }

  .notfound-btn.primary {
    background: var(--color-secondary-light);
    color: var(--color-primary);
  }

  .notfound-btn.primary:hover {
    background: var(--color-white);
    border-color: var(--color-white);
  }
</style>
