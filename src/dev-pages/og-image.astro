---
/**
 * Open Graph Image Generator
 *
 * Dimensions: 1200 x 630 px (Open Graph / social-share recommended size)
 *
 * Usage:
 * 1. Run dev server: bun run dev
 * 2. Navigate to http://localhost:4321/og-image
 * 3. Use controls to find a good frame (Space = pause, S = slow-mo)
 * 4. Press D to download the composed PNG, then save it to public/og-image.png
 *
 * Renders the same branded HeaderCanvas animation as the site background,
 * with the name/role overlay baked in so the downloaded PNG is share-ready.
 * Kept noindex/nofollow — this is a local authoring tool, not a public route.
 */

import HeaderCanvas from '../components/Background/HeaderCanvas.astro';
import { getPersonalInfo } from '../utils/data-loader';

const personal = getPersonalInfo();
const [primaryRole, secondaryRole] = personal.title.split('|').map((s) => s.trim());

const OG_WIDTH = 1200;
const OG_HEIGHT = 630;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Open Graph Image Generator</title>

    <!-- Load Inter so the baked canvas text matches the site (not a fallback). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --color-primary: #0a3a52;
        --color-primary-light: #004b72;
        --color-secondary: #006ba5;
        --color-secondary-light: #57acdc;
        --color-white: #ffffff;
      }

      body {
        font-family:
          'Inter',
          system-ui,
          -apple-system,
          sans-serif;
        background: #1a1a1a;
        color: white;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
      }

      .page-header {
        text-align: center;
        margin-bottom: 24px;
      }
      h1 {
        font-size: 24px;
        font-weight: 700;
        color: var(--color-secondary-light);
      }
      .dimensions {
        font-size: 13px;
        color: #999;
        font-family: 'Courier New', monospace;
        margin-top: 6px;
      }

      .canvas-wrapper {
        position: relative;
        width: 1200px;
        height: 630px;
        box-shadow: 0 10px 50px rgba(0, 0, 0, 0.5);
        border-radius: 4px;
        overflow: hidden;
        border: 2px solid rgba(62, 159, 212, 0.3);
        /* Brand backdrop behind the animated canvas */
        background: linear-gradient(135deg, #0a3a52 0%, #04283a 100%);
      }

      /* Text overlay baked over the animated canvas.
       HeaderCanvas.downloadScreenshot only captures the canvas, so we ALSO
       draw this text onto the export canvas via the hook below. */
      .og-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0 90px;
        pointer-events: none;
        /* Same text-readability treatment as the home page's Layer-4
         radial-overlay: a SOLID brand-color core that fully clears the
         shapes behind the text, fading to transparent so the motif stays
         visible toward the edges/corners. */
        background: radial-gradient(
          44% 60% at 50% 42%,
          var(--color-primary) 46%,
          rgba(10, 58, 82, 0) 100%
        );
      }
      /* Nudge the whole text block up so there is generous space above and below,
       matching the reference composition. */
      .og-text {
        transform: translateY(-6%);
      }
      .og-name {
        font-size: 96px;
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -1px;
        color: #fff;
      }
      .og-name .given {
        display: block;
      }
      .og-name .family {
        display: block;
      }
      .og-role {
        font-size: 42px;
        font-weight: 600;
        color: var(--color-secondary-light);
        margin-top: 28px;
      }
      .og-role-2 {
        font-size: 42px;
        font-weight: 600;
        color: var(--color-secondary-light);
        margin-top: 2px;
      }

      footer {
        margin-top: 24px;
        font-size: 12px;
        color: #666;
        text-align: center;
      }
      footer a {
        color: var(--color-secondary-light);
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="page-header">
      <h1>Open Graph Image</h1>
      <div class="dimensions">{OG_WIDTH} × {OG_HEIGHT} px — save export to public/og-image.png</div>
    </div>

    <div class="canvas-wrapper">
      <HeaderCanvas width={OG_WIDTH} height={OG_HEIGHT} autoPauseAfter={10} density={0.06} />
      <div
        class="og-overlay"
        id="og-overlay"
        data-given={personal.name.split(' ')[0]}
        data-family={personal.name.split(' ').slice(1).join(' ')}
        data-role={primaryRole}
        data-role2={secondaryRole}
      >
        <div class="og-text">
          <div class="og-name">
            <span class="given">{personal.name.split(' ')[0]}</span>
            <span class="family">{personal.name.split(' ').slice(1).join(' ')}</span>
          </div>
          <div class="og-role">{primaryRole}</div>
          {secondaryRole && <div class="og-role-2">{secondaryRole}</div>}
        </div>
      </div>
    </div>

    <footer>
      <p>Local-only Open Graph image generator · <a href="/">← Back to CV</a></p>
    </footer>

    <script>
      // Bake the text overlay into the exported PNG. HeaderCanvas exposes the
      // composited export canvas via a window hook it calls before download.
      (window as any).__ogDrawOverlay = (ctx: CanvasRenderingContext2D, w: number, h: number) => {
        const overlay = document.getElementById('og-overlay');
        if (!overlay) return;
        const given = overlay.getAttribute('data-given') || '';
        const family = overlay.getAttribute('data-family') || '';
        const role = overlay.getAttribute('data-role') || '';
        const role2 = overlay.getAttribute('data-role2') || '';
        const cx = w / 2;
        // Visual anchor for the text block, raised above true-center so there is
        // generous space above and below (matches the reference composition).
        const ay = h * 0.38;

        // Same text-readability treatment as the home page's Layer-4 radial
        // overlay: a SOLID brand-color core clears the shapes behind the text,
        // fading to transparent so the motif stays visible toward the edges.
        // Radius matches the CSS gradient (44% of width, ~0% stop at 46%).
        const rOuter = w * 0.44;
        const glow = ctx.createRadialGradient(cx, ay, rOuter * 0.46, cx, ay, rOuter);
        glow.addColorStop(0, '#0A3A52');
        glow.addColorStop(1, 'rgba(10, 58, 82, 0)');
        ctx.fillStyle = glow;
        ctx.fillRect(0, 0, w, h);

        ctx.textAlign = 'center';
        ctx.textBaseline = 'alphabetic';

        // Name — two centered lines (96px, ~100px line spacing)
        ctx.fillStyle = '#FFFFFF';
        ctx.font = '700 96px Inter, sans-serif';
        ctx.fillText(given, cx, ay - 50);
        ctx.fillText(family, cx, ay + 50);

        // Roles — centered cyan (42px)
        ctx.fillStyle = '#57ACDC';
        ctx.font = '600 42px Inter, sans-serif';
        ctx.fillText(role, cx, ay + 138);
        if (role2) {
          ctx.fillText(role2, cx, ay + 190);
        }
        ctx.textAlign = 'left';
      };
    </script>
  </body>
</html>
