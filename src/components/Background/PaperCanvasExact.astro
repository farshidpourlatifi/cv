---
// @ts-nocheck
/**
 * PaperCanvasExact Component
 *
 * Paper.js canvas with exact shapes from bg.svg design
 * All positions, colors, and sizes match the original Figma design
 */
---

<div id="geometric-canvas-container" class="paper-canvas-container">
  <canvas id="geometric-canvas" resize></canvas>
</div>

<style>
  .paper-canvas-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  #geometric-canvas {
    width: 100%;
    height: 100%;
    pointer-events: auto;
  }
</style>

<script>
  // @ts-nocheck — ported vanilla-JS Paper.js animation; intentionally untyped.
  // paper is dynamically imported in boot() below so the ~125KB bundle stays
  // off the critical path (and is never downloaded under reduced-motion).
  let paper;

  // Initialize Paper.js - run immediately since Astro scripts are deferred by default
  function initPaperCanvas() {
    const canvas = document.getElementById('geometric-canvas') as HTMLCanvasElement;
    if (!canvas) {
      console.error('Canvas not found!');
      return;
    }

    // console.log('Initializing Paper.js...');

    // Setup Paper.js
    paper.setup(canvas);

    // console.log('Paper.js setup complete');

    // ==================== DEVICE DETECTION & OPTIMIZATION ====================
    const isMobile =
      /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || window.innerWidth < 768;
    // Sections that show the canvas on mobile. The canvas is a single fixed,
    // full-viewport layer shared by every section, so it can't be present in
    // one and absent in another — visibility has to follow the scroll
    // position. On phones only the hero keeps it; behind the dense Skills and
    // Experience networks the text is the point, and the web competes with it
    // on a small screen while costing the most on the weakest hardware.
    const MOBILE_CANVAS_SECTIONS = ['top'];
    const hasReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // console.log('🔍 Device Detection:', { isMobile, isLowEnd, hasReducedMotion, cores: navigator.hardwareConcurrency });

    // Disable on very low-end devices
    if (hasReducedMotion || (navigator.hardwareConcurrency && navigator.hardwareConcurrency < 2)) {
      // console.log('⚠️ Canvas disabled - device too low-end or reduced motion preferred');
      canvas.style.display = 'none';
      return;
    }

    // Performance multipliers based on device
    const SHAPE_DENSITY_MULTIPLIER = 0.4; // isMobile ? 0.4 : isLowEnd ? 0.6 : 1.0;
    const CONNECTION_UPDATE_INTERVAL = 1; //isMobile ? 3 : isLowEnd ? 2 : 1;
    const ENABLE_MOUSE_INTERACTION = !isMobile;
    // Per-frame chance of seeding a spontaneous fire. Only a seed rate: each
    // fire pulses along every connection the node has and fires whatever those
    // pulses reach, so activity spreads well past this number. Lowered from
    // 0.02 because the denser network (more connections per node) turned the
    // same seed rate into near-constant firing.
    const RANDOM_FIRE_PROBABILITY = 0.006; // isMobile ? 0.0005 : isLowEnd ? 0.001 : 0.002;

    // Helper function to get CSS variable value
    const getCSSVariable = (variableName: string): string => {
      return getComputedStyle(document.documentElement).getPropertyValue(variableName).trim();
    };

    // Colors - using your Figma Design System from BaseLayout.astro
    const colors = {
      primary: getCSSVariable('--color-primary') || '#0A3A52', // Darkest Blue - Primary BG
      primaryLight: getCSSVariable('--color-primary-light') || '#004B72', // Dark Blue
      secondary: getCSSVariable('--color-secondary') || '#006BA5', // Medium Blue - Interactive
      secondaryLight: getCSSVariable('--color-secondary-light') || '#3E9FD4', // Cyan - Highlights & Titles
      tertiary: getCSSVariable('--color-secondary') || '#006BA5', // Alias for secondary (backward compatibility)
      accent: getCSSVariable('--color-accent') || '#F0000F', // Primary Red - CTA
      accentDark: getCSSVariable('--color-accent-dark') || '#BF0B16', // Dark Red
      lineAccent: getCSSVariable('--color-line-accent') || '#E00514', // Line accents
      white: getCSSVariable('--color-white') || '#FFFFFF',
      background: getCSSVariable('--color-primary') || '#0A3A52', // Use primary color as background (matches page bg)
    };

    // Configuration presets for different sections
    const configPresets = {
      top: {
        pattern: 'diagonal', // Diagonal sine wave pattern
        sizes: { circle: [14, 18, 12], rect: [15, 22, 18], triangle: [17, 14, 20] },
        distribution: {
          minDistance: 50,
          bandWidth: 300,
          sineAmplitude: 100,
          sineFrequency: 0.004,
          spacing: 5 / SHAPE_DENSITY_MULTIPLIER, // Acceptance rate: higher = more shapes
          spacingRandomness: 3,
          edgeMargin: 50,
          boundsInset: 30,
        },
        appearance: { strokeWidthOptions: [2, 3, 5], solidFillProbability: 0.4 },
      },
      skills: {
        pattern: 'curve', // Bezier curve using control points
        sizes: { circle: [5], rect: [5], triangle: [5] },
        distribution: {
          minDistance: 10,
          // Perpendicular scatter around the curve, symmetric: each shape lands
          // within +/- bandWidth/2 of the curve line. Widened to reach further
          // left; the curve's control points were pulled left by the same
          // measure so the extra width lands on-screen instead of being culled
          // off the right edge.
          bandWidth: 600, // Width of curve band
          // Despite the name, this is an acceptance rate, not a gap:
          // `Math.random() < spacing / 100`. Higher = MORE shapes. At 40 the
          // divisor makes it 100, i.e. every sample is kept — this is the
          // ceiling, and raising it further does nothing. Past here only
          // samplePitch below can add shapes.
          spacing: 40 / SHAPE_DENSITY_MULTIPLIER,
          // One sample per 6.7px of curve instead of the default 10 — 1.5x the
          // samples, and since `spacing` above already accepts every one of
          // them, 1.5x the shapes. This is the only lever left for density
          // once `spacing` is maxed.
          samplePitch: 6.7,
          spacingRandomness: 3,
          edgeMargin: 10,
          // Negative, unlike the other presets: the bounds check is plain
          // arithmetic, so a negative inset widens the keep-region past the
          // viewport instead of shrinking it inside. Shapes may sit 60px beyond
          // each edge, enough for the run to bleed off the top, bottom and right
          // rather than stopping short of them.
          // Kept deliberately shallow: off-screen shapes still animate and still
          // pay the O(n²) connection test every frame while rendering nothing,
          // so this margin is a visual-bleed allowance, not a canvas extension.
          boundsInset: -60,
          // Control points as fractions of the viewport, fed to a cubic Bezier.
          // The network runs bottom-to-top along the right edge, with only a
          // slight leftward lean in the middle — the control x values sit close
          // to the endpoints' so the run stays near-straight rather than bowed.
          // x and y both run past their bounds deliberately: the column straddles
          // the right edge and its ends sit off-screen, so it reads as part of a
          // larger network passing through rather than one that starts and stops
          // in view.
          curveControlPoints: [
            { x: 0.92, y: 1.35 }, // Start: below the bottom edge, on the right
            { x: 0.86, y: 0.7 }, // Control: slight lean left, lower
            { x: 0.84, y: 0.15 }, // Control: slight lean left, upper
            { x: 0.89, y: -0.35 }, // End: above the top edge, on the right
          ],
        },
        appearance: { strokeWidthOptions: [2], solidFillProbability: 0 },
      },
      experience: {
        // Mirrors the skills run: same curve pattern with every control point
        // reflected across the vertical axis (x -> 1 - x), so it hugs the left
        // edge instead of the right.
        pattern: 'curve',
        // Uniform, as skills is. The mixed 6-9px sizes here were the circle
        // pattern's, and at this density read as clutter next to the timeline
        // rather than as one network with the other section. 1.5x skills' 5px:
        // this band is sparser, so slightly larger nodes hold their weight.
        sizes: { circle: [7.5], rect: [7.5], triangle: [7.5] },
        // Shorter reach than the global 120. This section's band is far
        // narrower than skills', so the same shape count packs tighter and
        // equal reach put many more pairs in range — which is what made the
        // firing cascade run hotter here than in skills.
        connections: { maxDistance: 85 },
        distribution: {
          // Matches skills' so the two runs read as one network; the earlier 50
          // was tuned for the circle pattern's much sparser field.
          minDistance: 10,
          // Narrower than skills' 600: this side carries the timeline rail,
          // year badges and job titles. The year badges start at x~270 on a
          // 1440 viewport; at this width the scatter's right shoulder measures
          // x~220, leaving ~50px of clearance. Widening much past this starts
          // putting shapes through the badges.
          bandWidth: 260,
          // At the acceptance ceiling, as skills is — see the note there.
          spacing: 40 / SHAPE_DENSITY_MULTIPLIER,
          samplePitch: 6.7,
          spacingRandomness: 3,
          edgeMargin: 10,
          // Negative to let the run bleed off the left, top and bottom edges,
          // matching skills. See the note on skills' boundsInset. Only -10
          // here, not skills' -60: the band is narrow and hugs the left edge,
          // so a shallow allowance is all it takes to clip the run rather than
          // let it stop short — and every px past the edge is a shape that
          // animates and pays the connection test while rendering nothing.
          boundsInset: -10,
          // Skills' points mirrored (x -> 1 - x) and read bottom-to-top, giving
          // a run that starts above the top edge and exits below the bottom.
          // The control x values sit close to the endpoints' — that is what
          // keeps it near-straight. The previous points swung out to 0.22 while
          // the ends sat at 0.08/0.03, which bowed the run into an S across the
          // timeline rail instead of tracking the edge.
          curveControlPoints: [
            { x: 0.04, y: -0.35 }, // Start: above the top edge, on the left
            { x: 0.09, y: 0.15 }, // Control: slight lean right, upper
            { x: 0.07, y: 0.7 }, // Control: slight lean right, lower
            { x: 0.01, y: 1.35 }, // End: below the bottom edge, on the left
          ],
        },
        appearance: { strokeWidthOptions: [2], solidFillProbability: 0.2 },
      },
      contact: {
        // A ring of shapes centred in the viewport, echoing the closing
        // section's blurred circle. Distinct from the other three runs, which
        // hug edges — this one sits in the middle behind the contact CTAs.
        // Values dialed in via /tune.
        pattern: 'circle',
        sizes: { circle: [8, 6], rect: [8, 6], triangle: [6, 8] },
        connections: { maxDistance: 190, staticStrokeWidth: 2, staticDashArray: [1, 3] },
        distribution: {
          minDistance: 14,
          bandWidth: 40, // radial thickness of the ring
          circleRadius: 310, // ring radius
          circleCentered: true, // centre the circle in the viewport
          circleOffsetY: 0,
          spacing: 19, // runtime spacing (already ÷ SHAPE_DENSITY_MULTIPLIER)
          spacingRandomness: 8,
          edgeMargin: 57,
          boundsInset: 0,
        },
        appearance: { strokeWidthOptions: [4, 2, 1], solidFillProbability: 0.45 },
      },
    };

    // Dev tuning overrides written by the /tune page (localStorage). Deep-merged
    // into the presets before anything reads them, so the live preview reflects
    // slider changes on reload. No-op in normal use (nothing in localStorage).
    try {
      if (typeof localStorage !== 'undefined') {
        const raw = localStorage.getItem('canvasTuneOverrides');
        if (raw) {
          const overrides = JSON.parse(raw);
          for (const key of Object.keys(overrides)) {
            const preset = (configPresets as any)[key];
            if (!preset) continue;
            const o = overrides[key] || {};
            if (o.sizes) preset.sizes = { ...preset.sizes, ...o.sizes };
            if (o.connections)
              preset.connections = { ...(preset.connections || {}), ...o.connections };
            if (o.distribution) preset.distribution = { ...preset.distribution, ...o.distribution };
            if (o.appearance) preset.appearance = { ...preset.appearance, ...o.appearance };
          }
        }
      }
    } catch {
      // Ignore malformed overrides.
    }

    // Current active config (starts with the top section)
    let currentPresetName = 'top';
    let targetPresetName = 'top';
    let transitionProgress = 1; // 0-1, where 1 means fully transitioned

    // Build dynamic shapeConfig from preset
    const buildShapeConfig = (preset: typeof configPresets.top) => ({
      rotationSpeed: { min: -0.005, max: 0.005 },
      floatSpeed: { yMin: 0.01, yMax: 0.03, xMin: 0.0, xMax: 0.0 },
      amplitude: { yMin: 1, yMax: 4, xMin: 1, xMax: 1.03 },
      // Frames, not seconds: age advances once per frame, so ~0.5-1.33s at
      // 60fps. min stays above fadeInDuration + fadeOutDuration (20) so even
      // the shortest-lived shapes hold full opacity briefly instead of fading
      // straight from in to out.
      lifespan: { min: 30, max: 80 },
      firing: { decay: 0.08, cooldown: 180, lifespanExtension: 100 },
      sizes: preset.sizes,
      distribution: preset.distribution,
      // Per-section connection reach. Everything else about connections stays
      // global in connectionConfig; only this varies, because a section's band
      // width changes how densely the same shape count packs, and reach is what
      // decides how many pairs that packing puts in range.
      connections: {
        maxDistance: preset.connections?.maxDistance ?? connectionConfig.maxDistance,
        // Per-section resting line thickness and dash pattern; fall back to the
        // global defaults.
        staticStrokeWidth:
          (preset.connections as any)?.staticStrokeWidth ?? connectionConfig.staticStrokeWidth,
        staticDashArray:
          (preset.connections as any)?.staticDashArray ?? connectionConfig.staticDashArray,
      },
      appearance: {
        ...preset.appearance,
        initialRotation: 360,
        // Chance a shape is filled with its own stroke colour, reading as a
        // solid node; the rest keep the background fill and read as outlines.
        // Per-section; 0 when a preset doesn't ask for it. Every non-line shape
        // is filled either way — the background fill is what hides connection
        // lines running behind a shape, and a solid fill occludes them equally.
        solidFillProbability: preset.appearance.solidFillProbability ?? 0,
      },
      fade: { fadeInDuration: 10, fadeOutDuration: 10 },
      fireEffects: {
        randomFireProbability: 0.003,
        glowStrokeMultiplier: 3,
        glowBrightnessMultiplier: 0.3,
      },
      regeneration: { jitterX: 0, jitterY: 0, defaultSizeFallback: 20 },
    });

    // Connection line configuration - adjust all connection properties here.
    // Declared before the first buildShapeConfig call, which reads maxDistance
    // from it as the per-section fallback.
    const connectionConfig = {
      // Connection creation
      maxDistance: 120, // Maximum distance to connect shapes
      probability: 0.9, // Probability of creating a connection (0-1)

      // Static connection line appearance
      staticOpacity: 0.6, // Base opacity of connection lines (0-1)
      staticStrokeWidth: 1, // Line thickness
      staticDashArray: [1, 3], // Dash pattern [dash, gap]

      // Pulsing animation for connection lines
      pulseBaseOpacity: 0.5, // Minimum opacity during pulse
      pulseAmount: 0.5, // How much the pulse adds to opacity

      // Traveling pulse animation
      pulseSpeed: {
        min: 0.04, // Minimum pulse travel speed (slower)
        max: 0.08, // Maximum pulse travel speed (faster)
      },

      // Traveling pulse stroke width animation
      pulseStrokeWidth: {
        start: 0.05, // Starting width (thin)
        peak: 3, // Peak width (thick)
        end: 0.05, // Ending width (medium)
      },

      // Phase durations for pulse animation
      pulseGrowthPhase: 0.3, // Duration of growth phase (0-1)
      pulseFadePhase: 0.7, // Duration of fade/shrink phase (0-1)

      // Pulse visual effects
      pulseVisuals: {
        opacityMultiplier: 0.5, // How much base pulse opacity affects final value (0-1)
        opacityOffset: 0.5, // Offset added to pulse opacity calculation (0-1)
      },

      // Connection data initialization
      initialization: {
        maxAge: 60, // Maximum initial age for staggered animation
        initialFireTime: -300, // Initial lastFireTime value (frame number)
      },
    };

    // Initialize with the top-section preset
    let shapeConfig = buildShapeConfig(configPresets.top);

    // ==================== BEZIER CURVE FUNCTIONS ====================

    // Cubic Bezier curve function: B(t) = (1-t)³P0 + 3(1-t)²tP1 + 3(1-t)t²P2 + t³P3
    const bezierPoint = (
      t: number,
      p0: { x: number; y: number },
      p1: { x: number; y: number },
      p2: { x: number; y: number },
      p3: { x: number; y: number }
    ) => {
      const mt = 1 - t;
      const mt2 = mt * mt;
      const mt3 = mt2 * mt;
      const t2 = t * t;
      const t3 = t2 * t;

      return {
        x: mt3 * p0.x + 3 * mt2 * t * p1.x + 3 * mt * t2 * p2.x + t3 * p3.x,
        y: mt3 * p0.y + 3 * mt2 * t * p1.y + 3 * mt * t2 * p2.y + t3 * p3.y,
      };
    };

    // Approximate the arc length of a Bezier curve by walking it in fixed
    // parameter steps and summing the chord lengths. 50 steps is plenty here:
    // the result only sets a sample count, so small error is irrelevant.
    const bezierLength = (
      p0: { x: number; y: number },
      p1: { x: number; y: number },
      p2: { x: number; y: number },
      p3: { x: number; y: number }
    ) => {
      const STEPS = 50;
      let length = 0;
      let prev = bezierPoint(0, p0, p1, p2, p3);

      for (let i = 1; i <= STEPS; i++) {
        const point = bezierPoint(i / STEPS, p0, p1, p2, p3);
        length += Math.hypot(point.x - prev.x, point.y - prev.y);
        prev = point;
      }

      return length;
    };

    // Calculate tangent (derivative) of Bezier curve at parameter t
    const bezierTangent = (
      t: number,
      p0: { x: number; y: number },
      p1: { x: number; y: number },
      p2: { x: number; y: number },
      p3: { x: number; y: number }
    ) => {
      const mt = 1 - t;
      const mt2 = mt * mt;
      const t2 = t * t;

      const dx =
        -3 * mt2 * p0.x +
        3 * mt2 * p1.x -
        6 * mt * t * p1.x +
        6 * mt * t * p2.x -
        3 * t2 * p2.x +
        3 * t2 * p3.x;
      const dy =
        -3 * mt2 * p0.y +
        3 * mt2 * p1.y -
        6 * mt * t * p1.y +
        6 * mt * t * p2.y -
        3 * t2 * p2.y +
        3 * t2 * p3.y;

      return { dx, dy };
    };

    // ==================== SHAPE GENERATION FUNCTIONS ====================

    // Pre-calculate constants used in generation
    const shapeTypes = ['circle', 'rect', 'triangle'];
    const colorOptions = [
      colors.primaryLight,
      colors.secondary,
      colors.accent,
      colors.tertiary,
      colors.white,
    ];

    // Generate shapes within a diagonal sine wave band (bottom-left to top-right)
    const generateShapesInDiagonalBand = () => {
      const generatedShapes: any[] = [];
      // Shape distribution parameters from config
      const minDistance = shapeConfig.distribution.minDistance;
      const bandWidth = shapeConfig.distribution.bandWidth;
      const sineAmplitude = shapeConfig.distribution.sineAmplitude;
      const sineFrequency = shapeConfig.distribution.sineFrequency;

      // Diagonal line from bottom-left to top-right
      const startPoint = { x: 0, y: paper.view.size.height };
      const endPoint = { x: paper.view.size.width, y: 0 };

      // Calculate diagonal distance
      const diagonalLength = Math.sqrt(
        Math.pow(endPoint.x - startPoint.x, 2) + Math.pow(endPoint.y - startPoint.y, 2)
      );

      // Unit vector along diagonal
      const directionX = (endPoint.x - startPoint.x) / diagonalLength;
      const directionY = (endPoint.y - startPoint.y) / diagonalLength;

      // Perpendicular vector (for band width)
      const perpX = -directionY;
      const perpY = directionX;

      const sizes = shapeConfig.sizes;
      const strokeWidthOptions = shapeConfig.appearance.strokeWidthOptions;

      // Counters for equal distribution
      let shapeCounter = 0;
      let colorCounter = 0;
      let strokeCounter = 0;

      // Check if position is too close to existing shapes
      const isTooClose = (x: number, y: number, existing: any[]) => {
        return existing.some((shape) => {
          const dx = shape.x - x;
          const dy = shape.y - y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          return distance < minDistance;
        });
      };

      // Generate shapes along the diagonal band
      const spacing = shapeConfig.distribution.spacing;
      const edgeMargin = shapeConfig.distribution.edgeMargin;
      const spacingRandomness = shapeConfig.distribution.spacingRandomness;

      for (
        let t = edgeMargin;
        t < diagonalLength - edgeMargin;
        t += spacing + Math.random() * spacingRandomness
      ) {
        // Position along the diagonal
        const baseX = startPoint.x + directionX * t;
        const baseY = startPoint.y + directionY * t;

        // Sine wave offset (oscillates perpendicular to diagonal)
        const sineOffset = Math.sin(t * sineFrequency) * sineAmplitude;

        // Random offset within band width
        const bandOffset = (Math.random() - 0.5) * bandWidth + sineOffset;

        // Final position
        const x = baseX + perpX * bandOffset;
        const y = baseY + perpY * bandOffset;

        // Check bounds and overlap (reduced padding for more density)
        const boundsInset = shapeConfig.distribution.boundsInset;
        if (
          x >= boundsInset &&
          x <= paper.view.size.width - boundsInset &&
          y >= boundsInset &&
          y <= paper.view.size.height - boundsInset &&
          !isTooClose(x, y, generatedShapes)
        ) {
          // Equal distribution: cycle through shape types
          const type = shapeTypes[shapeCounter % shapeTypes.length];
          shapeCounter++;

          const sizeOptions = sizes[type as keyof typeof sizes];
          const size = sizeOptions[Math.floor(Math.random() * sizeOptions.length)];

          // Equal distribution: cycle through colors
          const strokeColor = colorOptions[colorCounter % colorOptions.length];
          colorCounter++;

          // Equal distribution: cycle through stroke widths
          const strokeWidth = strokeWidthOptions[strokeCounter % strokeWidthOptions.length];
          strokeCounter++;

          // Random rotation
          const rotation = Math.random() * shapeConfig.appearance.initialRotation;

          // Add shape
          if (type === 'circle') {
            generatedShapes.push({
              type: 'circle',
              x,
              y,
              radius: size,
              strokeColor,
              strokeWidth,
            });
          } else if (type === 'rect') {
            generatedShapes.push({
              type: 'rect',
              x,
              y,
              width: size,
              height: size,
              radius: Math.random() > 0.5 ? 2.5 : 4.5,
              rotation,
              strokeColor,
              strokeWidth,
            });
          } else if (type === 'triangle') {
            generatedShapes.push({
              type: 'triangle',
              x,
              y,
              size,
              rotation,
              strokeColor,
              strokeWidth,
            });
          }
        }
      }

      return generatedShapes;
    };

    // Generate shapes in a vertical line from bottom to top (centered)
    const generateShapesInVerticalLine = () => {
      const generatedShapes: any[] = [];
      const minDistance = shapeConfig.distribution.minDistance;
      const bandWidth = shapeConfig.distribution.bandWidth;

      // Get positioning parameters (with defaults)
      const horizontalPosition = (shapeConfig.distribution as any).horizontalPosition || 0.5;
      const angleDegrees = (shapeConfig.distribution as any).angle || 0;

      // Convert angle to radians
      const angleRadians = (angleDegrees * Math.PI) / 180;

      // Calculate base X position
      const baseX = paper.view.size.width * horizontalPosition;

      // Calculate horizontal offset based on angle
      const height = paper.view.size.height;
      const horizontalOffset = Math.tan(angleRadians) * height;

      // Calculate the actual line direction vector (from bottom to top)
      const lineDirX = horizontalOffset;
      const lineDirY = -height;

      // Calculate perpendicular vector (rotate 90° counter-clockwise)
      const perpDirX = -lineDirY; // = height
      const perpDirY = lineDirX; // = horizontalOffset

      // Normalize the perpendicular vector
      const perpLength = Math.sqrt(perpDirX * perpDirX + perpDirY * perpDirY);
      const perpX = perpDirX / perpLength;
      const perpY = perpDirY / perpLength;

      // Shape types for equal distribution
      const shapeTypes = ['circle', 'rect', 'triangle'];
      const sizes = shapeConfig.sizes;
      const colorOptions = [
        colors.primaryLight,
        colors.secondary,
        colors.accent,
        colors.tertiary,
        colors.white,
      ];
      const strokeWidthOptions = shapeConfig.appearance.strokeWidthOptions;

      // Counters for equal distribution
      let shapeCounter = 0;
      let colorCounter = 0;
      let strokeCounter = 0;

      // Check if position is too close to existing shapes
      const isTooClose = (x: number, y: number, existing: any[]) => {
        return existing.some((shape) => {
          const dx = shape.x - x;
          const dy = shape.y - y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          return distance < minDistance;
        });
      };

      // Generate shapes along angled line from bottom to top
      const spacing = shapeConfig.distribution.spacing;
      const edgeMargin = shapeConfig.distribution.edgeMargin;
      const spacingRandomness = shapeConfig.distribution.spacingRandomness;
      const boundsInset = shapeConfig.distribution.boundsInset;

      for (
        let y = edgeMargin;
        y < height - edgeMargin;
        y += spacing + Math.random() * spacingRandomness
      ) {
        // Progress along the line (0 at bottom, 1 at top)
        const progress = y / height;

        // X position along the angled line
