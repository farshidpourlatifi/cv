{
  "name": "cv-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "volta": {
    "node": "22.17.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "bun run validate && astro check && astro build",
    "build:prod": "bun run validate && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "bun scripts/validate-data.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:build-output": "node scripts/build-output-checks.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "test:security": "node tests/security/headers-check.mjs",
    "test:perf": "lhci autorun",
    "test:all": "bun run validate && bun run test && bun run build && bun run test:build-output && bun run test:e2e",
    "audit": "bun audit",
    "preflight": "bun run test:all && bun run audit",
    "generate:pdf": "node scripts/generate-cv-pdf.js",
    "optimize:images": "node scripts/optimize-images.js",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/netlify": "^6.6.0",
    "@astrojs/react": "^4.4.0",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.15.1",
    "astro-compress": "^2.3.8",
    "p5": "^2.0.5",
    "paper": "^0.12.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.0",
    "@types/p5": "^1.7.7",
    "axe-playwright": "^2.2.2",
    "eslint": "^9.38.0",
    "eslint-plugin-astro": "^1.3.1",
    "jsdom": "^27.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.3"
  }
}
